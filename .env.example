# Anki Desktop Docker - Environment Configuration
# Copy this file to .env and configure as needed

# ============================================
# System Settings
# ============================================
PUID=1000
PGID=1000
TZ=UTC

# ============================================
# AnkiWeb Sync Configuration
# ============================================
# For automated setup, provide your AnkiWeb credentials
# Use either password OR sync key (sync key is more secure)

# Required for automated setup
ANKIWEB_USER=

# Option 1: Use password (will retrieve sync key automatically)
ANKIWEB_PASSWORD=

# Option 2: Use sync key directly (preferred - get with scripts/get_anki_synckey.py)
ANKIWEB_SYNC_KEY=

# Auto-sync on every container start (default: true)
# Set to 'false' to disable automatic sync
AUTO_SYNC_ON_START=true

# Anki interface language (default: en_US)
# Common values: en_US, zh_CN, ja_JP, de_DE, fr_FR, es_ES, pt_BR, ru_RU
ANKI_LANG=en_US

# ============================================
# AnkiConnect API Configuration
# ============================================
# API authentication is required, including for existing profiles.

# Bind address (default: 0.0.0.0 - allows external connections)
ANKICONNECT_BIND_ADDRESS=0.0.0.0

# Bind port (default: 8765)
ANKICONNECT_BIND_PORT=8765

# CORS allowlist. Use exact browser origins; wildcard access is rejected.
# Can be JSON array: ["http://localhost:3000","http://example.com"]
# Or single value: "http://localhost:3000"
ANKICONNECT_CORS_ORIGIN=["https://mokuro-reader-louis.vercel.app"]

# Required API key. Generate with: openssl rand -hex 32
# Include it as the top-level "key" in every AnkiConnect request.
ANKICONNECT_API_KEY=

# API log file path (optional)
# If set, AnkiConnect will log requests to this file
ANKICONNECT_API_LOG_PATH=

# ============================================
# CJK Font Support (Chinese/Japanese/Korean)
# ============================================
# Uncomment to enable CJK fonts
# DOCKER_MODS=linuxserver/mods:universal-package-install
# INSTALL_PACKAGES=language-pack-zh-hans|fonts-arphic-ukai|fonts-arphic-uming|fonts-ipafont-mincho|fonts-ipafont-gothic|fonts-unfonts-core

# ============================================
# Security Notes
# ============================================
# - NEVER commit .env file to git (already in .gitignore)
# - Use ANKIWEB_SYNC_KEY instead of password when possible
# - Get sync key with: python3 scripts/get_anki_synckey.py --user USER --password PASS
# - Rotate sync key periodically by logging into AnkiWeb
# - Restrict ANKICONNECT_CORS_ORIGIN for production deployments
# - ANKICONNECT_API_KEY is required and must contain at least 32 characters
